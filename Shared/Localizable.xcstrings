          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas listas tienen %lld entradas. La VPN del iPhone dispone de poca memoria, así que las listas muy grandes pueden impedir que se inicie. Desactiva las que no necesites."
          }
        },
        "it" : {
          "stringUnit" : {
