      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düğmeye dokunun. Tüm uygulamaların trafiği, yerel bir VPN olarak bu iPhone'daki tpws üzerinden geçer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf den Schalter. Danach läuft der Datenverkehr aller Apps als lokales VPN über tpws auf diesem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
