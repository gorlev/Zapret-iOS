    "Cuts the TLS hello into two records in the middle of the site name. Try it when splitting alone is not enough." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLS hello mesajını site adının ortasından iki kayda ayırır. Tek başına bölme yetmediğinde deneyin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilt das TLS-Hello mitten im Domainnamen in zwei Records. Probier es, wenn ein einfacher Split nicht reicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta el TLS hello en dos registros por la mitad del nombre del sitio. Pruébala si dividir el paquete no basta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide il TLS hello in due record a metà del nome del sito. Provala quando lo split da solo non basta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe le hello TLS en deux records au milieu du nom du site. À essayer quand la découpe seule ne suffit pas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta o TLS hello em dois registros no meio do nome do site. Experimente quando só a divisão não resolver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делит TLS ClientHello на две записи посередине имени сайта. Попробуйте, если одного сплита мало."
          }
        }
      }
    },
    "Cuts the TLS hello into two records, then splits the packet at the domain. Works on most providers." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLS hello mesajını iki kayda ayırır, ardından paketi alan adından böler. Çoğu operatörde işe yarar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilt das TLS-Hello in zwei Records und splittet das Paket dann an der Domain. Hilft bei den meisten Anbietern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta el TLS hello en dos registros y luego divide el paquete en el dominio. Funciona con la mayoría de los proveedores."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide il TLS hello in due record, poi spezza il pacchetto sul dominio. Funziona con la maggior parte dei provider."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe le hello TLS en deux records, puis découpe le paquet au niveau du domaine. Efficace chez la plupart des FAI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta o TLS hello em dois registros e depois divide o pacote no domínio. Funciona na maioria das operadoras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делит TLS ClientHello на две записи, затем разрезает пакет на домене. Срабатывает у большинства провайдеров."
          }
        }
      }
    },
    "Cuts the first packet into several small pieces, so none of them shows the whole site name." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk paketi birkaç küçük parçaya böler; hiçbir parçada site adı tam olarak görünmez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zerlegt das erste Paket in mehrere kleine Teile, sodass keines den ganzen Domainnamen enthält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta el primer paquete en varios fragmentos pequeños para que ninguno muestre el nombre completo del sitio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taglia il primo pacchetto in tanti piccoli pezzi, così nessuno contiene il nome intero del sito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe le premier paquet en plusieurs petits fragments, dont aucun ne contient le nom du site en entier."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta o primeiro pacote em vários pedaços pequenos, para que nenhum deles mostre o nome do site inteiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режет первый пакет на несколько мелких частей, и ни в одной нет имени сайта целиком."
          }
        }
      }
    },
