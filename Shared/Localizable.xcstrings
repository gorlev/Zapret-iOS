        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@=%@ no es una lista de puertos. Usa puertos y rangos como 80,443 o 1000-2000."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@=%@ non è un elenco di porte. Usa porte e intervalli come 80,443 o 1000-2000."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@=%@ n’est pas une liste de ports. Utilisez des ports et des plages comme 80,443 ou 1000-2000."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@=%@ não é uma lista de portas. Use portas e intervalos como 80,443 ou 1000-2000."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@=%@ — не список портов. Укажите порты и диапазоны, например 80,443 или 1000-2000."
          }
        }
      }
    },
