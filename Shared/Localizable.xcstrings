    "Domains blocked in Russia, as the AntiZapret project collects them. A large list." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AntiZapret projesinin topladığı, Rusya'da engellenen alan adları. Büyük bir liste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Russland gesperrte Domains, gesammelt vom Projekt AntiZapret. Eine große Liste."
