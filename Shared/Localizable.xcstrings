    "%@=%@ is not a list of positions. Use numbers (not 0) or markers like 1,midsld or sniext+1." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@=%@ bir konum listesi değil. Sayı (0 olmamalı) ya da 1,midsld veya sniext+1 gibi işaretler kullanın."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@=%@ ist keine Liste von Positionen. Verwende Zahlen (nicht 0) oder Marker wie 1,midsld oder sniext+1."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@=%@ no es una lista de posiciones. Usa números (distintos de 0) o marcadores como 1,midsld o sniext+1."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@=%@ non è un elenco di posizioni. Usa numeri (diversi da 0) o marcatori come 1,midsld o sniext+1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@=%@ n’est pas une liste de positions. Utilisez des nombres (pas 0) ou des repères comme 1,midsld ou sniext+1."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@=%@ não é uma lista de posições. Use números (diferentes de 0) ou marcadores como 1,midsld ou sniext+1."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@=%@ — не список позиций. Укажите числа (не 0) или маркеры, например 1,midsld или sniext+1."
          }
        }
      }
    },
    "%@=%@ is not a port list. Use ports and ranges like 80,443 or 1000-2000." : {
