    "Tries every split and TLS-record combination zapret's blockcheck tests, with TLS 1.3 and TLS 1.2 separately. Takes a few minutes." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zapret'in blockcheck aracının denediği tüm bölme ve TLS kaydı birleşimlerini TLS 1.3 ve TLS 1.2 için ayrı ayrı dener. Birkaç dakika sürer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testet alle Kombinationen aus Split und TLS-Record, die blockcheck von zapret prüft, getrennt für TLS 1.3 und TLS 1.2. Dauert ein paar Minuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba todas las combinaciones de división y registros TLS que usa blockcheck de zapret, con TLS 1.3 y TLS 1.2 por separado. Tarda unos minutos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
