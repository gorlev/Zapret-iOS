          "stringUnit" : {
            "state" : "translated",
            "value" : "%@=%@ bir bağlantı noktası listesi değil. 80,443 veya 1000-2000 gibi bağlantı noktaları ve aralıkları kullanın."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@=%@ ist keine Portliste. Verwende Ports und Bereiche wie 80,443 oder 1000-2000."
