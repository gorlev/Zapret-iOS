    "Adds an urgent byte between the pieces that the server drops but the filter reads." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parçaların arasına, sunucunun yok saydığı ama filtrenin okuduğu acil bir bayt ekler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt zwischen den Teilen ein dringendes Byte ein, das der Server verwirft, der Filter aber mitliest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserta entre los fragmentos un byte urgente que el servidor descarta, pero que el filtro sí lee."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisce tra i pezzi un byte urgente: il server lo scarta, il filtro invece lo legge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisse entre les fragments un octet urgent que le serveur ignore, mais que le filtre prend en compte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insere entre as partes um byte urgente que o servidor descarta, mas o filtro lê."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставляет между частями срочный байт: сервер его отбрасывает, а DPI принимает за данные."
          }
        }
      }
    },
    "Adds filler headers before the Host header, for plain HTTP sites where the filter reads only the start." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Host başlığından önce dolgu başlıkları ekler. Filtrenin yalnızca isteğin başını okuduğu şifresiz HTTP siteleri için."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt Füll-Header vor dem Host-Header ein, für unverschlüsselte HTTP-Websites, bei denen der Filter nur den Anfang liest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade cabeceras de relleno antes de la cabecera Host, para sitios con HTTP sin cifrar en los que el filtro solo lee el principio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge header di riempimento prima dell’header Host, per i siti in HTTP semplice dove il filtro legge solo l’inizio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute des en-têtes de remplissage avant l’en-tête Host, pour les sites en HTTP simple dont le filtre ne lit que le début."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona cabeçalhos de enchimento antes do cabeçalho Host, para sites em HTTP simples em que o filtro só lê o começo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставляет перед Host заголовки-заполнители. Для сайтов на обычном HTTP, где DPI читает только начало запроса."
          }
        }
      }
    },
