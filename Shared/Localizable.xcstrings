        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dominios bloqueados en Rusia según los recopila el proyecto AntiZapret. Es una lista grande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domini bloccati in Russia, raccolti dal progetto AntiZapret. Una lista molto ampia."
          }
        },
        "fr" : {
          "stringUnit" : {
