          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces listes contiennent %lld entrées. Le VPN sur iPhone dispose de peu de mémoire : des listes très volumineuses peuvent l’empêcher de démarrer. Désactivez celles dont vous n’avez pas besoin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
