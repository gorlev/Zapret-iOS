    "These lists hold %lld entries. The VPN on iPhone has little memory, so very large lists can keep it from starting. Turn off the ones you do not need." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu listelerde %lld kayıt var. iPhone'daki VPN'in belleği azdır; çok büyük listeler başlamasını engelleyebilir. İhtiyacınız olmayanları kapatın."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
