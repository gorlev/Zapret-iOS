    "Splits the first packet in the middle of the site name, so the filter never sees it whole." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk paketi site adının ortasından böler; böylece filtre adı hiçbir zaman tam olarak göremez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilt das erste Paket mitten im Domainnamen, sodass der Filter ihn nie vollständig zu sehen bekommt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide el primer paquete por la mitad del nombre del sitio para que el filtro no llegue a verlo completo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spezza il primo pacchetto a metà del nome del sito, così il filtro non lo vede mai per intero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe le premier paquet au milieu du nom du site, pour que le filtre ne le voie jamais en entier."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide o primeiro pacote no meio do nome do site, para que o filtro nunca o veja inteiro."
