    "%@ needs a byte offset like 100, or n and a block number like n2." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ için 100 gibi bir bayt konumu ya da n2 gibi n ve bir blok numarası gerekir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ braucht einen Byte-Offset wie 100 oder n mit einer Blocknummer wie n2."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ necesita un desplazamiento en bytes como 100, o n y un número de bloque como n2."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ richiede uno scostamento in byte come 100, oppure n e un numero di blocco come n2."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ demande un décalage en octets comme 100, ou n et un numéro de bloc comme n2."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ precisa de um deslocamento em bytes como 100, ou n e um número de bloco como n2."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ требует смещение в байтах, например 100, либо n и номер блока, например n2."
          }
        }
      }
    },
