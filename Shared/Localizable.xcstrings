        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Домены, заблокированные в России, в сборке проекта АнтиЗапрет. Большой список."
          }
        }
      }
    },
    "Domains blocked in Russia: the registry, cleaned up, plus sites blocked without it." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rusya'da engellenen alan adları: temizlenmiş resmî kayıt ve kayıt dışında engellenen siteler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Russland gesperrte Domains: das bereinigte Sperrregister plus Websites, die ohne Eintrag gesperrt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dominios bloqueados en Rusia: el registro oficial depurado, más los sitios bloqueados fuera de él."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domini bloccati in Russia: il registro ufficiale ripulito, più i siti bloccati senza passare dal registro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domaines bloqués en Russie : le registre officiel, nettoyé, plus les sites bloqués hors registre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domínios bloqueados na Rússia: o registro oficial, já limpo, mais os sites bloqueados fora dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Домены, заблокированные в России: очищенный реестр плюс сайты, заблокированные без внесения в него."
          }
        }
      }
    },
    "Domains from Russia's block registry that still resolve." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
