    "An out-of-band byte and disorder together break connections on iPhone, and tpws refuses them. Turn on only one of them." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone'da bant dışı bayt ile karışık sıra birlikte bağlantıları bozar ve tpws bunları reddeder. Yalnızca birini açın."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Out-of-Band-Byte und Disorder zusammen brechen auf dem iPhone die Verbindungen ab, tpws lehnt sie ab. Schalte nur eines von beiden ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un byte fuera de banda y el desorden juntos cortan las conexiones en iPhone, y tpws los rechaza. Activa solo uno de los dos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su iPhone un byte out-of-band e disorder insieme interrompono le connessioni e tpws li rifiuta. Attiva solo uno dei due."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un octet hors bande et le désordre ensemble coupent les connexions sur iPhone, et tpws les refuse. N’activez que l’un des deux."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um byte fora de banda e o disorder juntos quebram as conexões no iPhone, e o tpws os recusa. Ative só um dos dois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На iPhone внеполосный байт и disorder вместе ломают соединения, и tpws их не принимает. Включите что-то одно."
          }
        }
      }
    },
